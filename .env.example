# Copie para .env (desenvolvimento) ou cadastre na Vercel (produção).

# Chave usada para assinar os logins. Use um valor longo e aleatório.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Conta do administrador (criada na primeira inicialização).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Banco Turso (obrigatório na Vercel). Em desenvolvimento, se vazio, usa server/medplanner.db local.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Opcional: restringe o login Google ao seu Client ID.
GOOGLE_CLIENT_ID=
